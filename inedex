    <!-- Application JavaScript -->
    <script>
        // --- State Management ---
        let appState = {
            onboardingCompleted: false,
            darkMode: false,
            calendarView: 'semana',
            userProfile: {
                sleepTime: '23:00',
                wakeTime: '07:00',
                fixedTitle: 'Trabajo / Oficina',
                fixedCategory: 'trabajo',
                allergies: 'Ninguna',
                isMinor: false
            },
            activities: [
                { id: '1', title: 'Trabajo Principal', day: 'Lunes', start: '09:00', end: '17:00', category: 'trabajo', priority: 'alta', completed: true },
                { id: '2', title: 'Entrenamiento Gimnasio', day: 'Lunes', start: '18:00', end: '19:15', category: 'entrenamiento', priority: 'media', completed: true },
                { id: '3', title: 'Estudio Programación', day: 'Martes', start: '16:00', end: '18:30', category: 'estudio', priority: 'media', completed: false },
                { id: '4', title: 'Sesión de Estudio', day: 'Jueves', start: '16:00', end: '18:00', category: 'estudio', priority: 'alta', completed: false },
                { id: '5', title: 'Descanso / Paseo', day: 'Viernes', start: '17:00', end: '19:00', category: 'descanso', priority: 'baja', completed: false }
            ],
            meals: {
                'Lunes': { desayuno: 'Tostadas con palta y huevo', almuerzo: 'Ensalada de pollo y quinoa', merienda: 'Yogurt con frutos secos', cena: 'Salmón al horno con vegetales', consumed: { desayuno: true, almuerzo: true, merienda: false, cena: false } },
                'Martes': { desayuno: 'Avena con banana y canela', almuerzo: 'Pasta integral con verduras', merienda: 'Fruta fresca y té', cena: 'Pechuga de pollo a la plancha', consumed: { desayuno: false, almuerzo: false, merienda: false, cena: false } },
                'Miércoles': { desayuno: 'Panqueques de avena', almuerzo: 'Arroz con lentejas y ensalada', merienda: 'Tostadas con queso crema', cena: 'Tortilla de vegetales', consumed: { desayuno: false, almuerzo: false, merienda: false, cena: false } },
                'Jueves': { desayuno: 'Yogurt con granola', almuerzo: 'Filet de merluza con puré', merienda: 'Frutos secos', cena: 'Sopa de verduras y pan integral', consumed: { desayuno: false, almuerzo: false, merienda: false, cena: false } },
                'Viernes': { desayuno: 'Tostadas integrales', almuerzo: 'Wrap de atún y vegetales', merienda: 'Licuado de frutas', cena: 'Pizza casera liviana', consumed: { desayuno: false, almuerzo: false, merienda: false, cena: false } },
                'Sábado': { desayuno: 'Huevos revueltos y tostadas', almuerzo: 'Asado con ensalada mixta', merienda: 'Café con medialunas', cena: 'Picada saludable', consumed: { desayuno: false, almuerzo: false, merienda: false, cena: false } },
                'Domingo': { desayuno: 'Pancakes caseros', almuerzo: 'Pasta casera', merienda: 'Infusión con galletas', cena: 'Tarta de acelga y zapallito', consumed: { desayuno: false, almuerzo: false, merienda: false, cena: false } }
            },
            water: {
                consumedMl: 1500,
                goalMl: 2500,
                history: [500, 500, 500]
            },
            habits: [
                { id: 'h1', title: 'Lectura de 20 minutos', completedToday: true },
                { id: 'h2', title: 'Estiramiento / Movilidad', completedToday: false },
                { id: 'h3', title: 'Caminar 7,000 pasos', completedToday: true }
            ],
            showCalories: false
        };

        // --- Initialization ---
        window.onload = function() {
            loadState();
            setupDateDisplay();
            renderAll();
            if (!appState.onboardingCompleted) {
                document.getElementById('onboarding-modal').classList.remove('hidden');
            }
        };

        function loadState() {
            const saved = localStorage.getItem('mi_semana_state_v2');
            if (saved) {
                try { appState = JSON.parse(saved); } catch (e) { console.error(e); }
            }
            if (appState.darkMode) {
                document.documentElement.classList.add('dark');
            }
        }

        function saveState() {
            localStorage.setItem('mi_semana_state_v2', JSON.stringify(appState));
        }

        function setupDateDisplay() {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateStr = new Date().toLocaleDateString('es-ES', options);
            document.getElementById('current-date-display').innerText = capitalizeFirst(dateStr);
        }

        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        // --- Navigation ---
        let currentTab = 'inicio';
        function switchTab(tabId) {
            currentTab = tabId;
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                if(btn.getAttribute('data-tab') === tabId) {
                    btn.className = "nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950/50";
                } else {
                    btn.className = "nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50";
                }
            });

            document.querySelectorAll('.mobile-nav-btn').forEach(btn => {
                if(btn.getAttribute('data-tab') === tabId) {
                    btn.className = "mobile-nav-btn flex flex-col items-center py-1 px-3 text-primary-600 dark:text-primary-400";
                } else {
                    btn.className = "mobile-nav-btn flex flex-col items-center py-1 px-3 text-slate-400 hover:text-slate-600";
                }
            });

            const titles = { inicio: 'Inicio', semana: 'Mi Semana', comidas: 'Comidas & Menú', habitos: 'Hábitos & Agua', estadisticas: 'Estadísticas', configuracion: 'Configuración' };
            document.getElementById('mobile-title').innerText = titles[tabId] || 'Mi Semana';
            window.scrollTo(0, 0);
        }

        function toggleDarkMode() {
            appState.darkMode = !appState.darkMode;
            if (appState.darkMode) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
            saveState();
        }

        // --- Rendering Engine ---
        function renderAll() {
            renderInicio();
            renderCalendar();
            renderMeals();
            renderHabits();
            renderStats();
        }

        function renderInicio() {
            // Next activity
            const pendingActs = appState.activities.filter(a => !a.completed).sort((a,b) => a.start.localeCompare(b.start));
            if (pendingActs.length > 0) {
                const next = pendingActs[0];
                document.getElementById('next-act-title').innerText = next.title;
                document.getElementById('next-act-time').innerText = `${next.day} • ${next.start} - ${next.end}`;
                document.getElementById('next-act-category').innerText = capitalizeFirst(next.category);
            } else {
                document.getElementById('next-act-title').innerText = '¡Todo al día!';
                document.getElementById('next-act-time').innerText = 'No hay actividades pendientes';
                document.getElementById('next-act-category').innerText = 'Libre';
            }

            // Today list (let's assume Jueves or current day)
            const todayActs = appState.activities.filter(a => a.day === 'Jueves');
            document.getElementById('today-count-badge').innerText = `${todayActs.length} actividades`;
            const listEl = document.getElementById('today-activities-list');
            if (todayActs.length === 0) {
                listEl.innerHTML = `<p class="text-xs text-slate-400 italic py-2">No hay actividades programadas para hoy.</p>`;
            } else {
                listEl.innerHTML = todayActs.map(act => `
                    <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/60 dark:border-slate-600/60">
                        <div class="flex items-center space-x-3">
                            <input type="checkbox" ${act.completed ? 'checked' : ''} onchange="toggleActivityComplete('${act.id}')" class="w-4 h-4 text-primary-600 rounded border-slate-300">
                            <div>
                                <h5 class="text-sm font-semibold ${act.completed ? 'line-through text-slate-400' : ''}">${act.title}</h5>
                                <p class="text-[11px] text-slate-500">${act.start} - ${act.end} • <span class="uppercase font-medium">${act.category}</span></p>
                            </div>
                        </div>
                        <button onclick="deleteActivity('${act.id}')" class="text-slate-400 hover:text-red-500 text-xs p-1.5"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `).join('');
            }

            // Water update
            const wPercent = Math.min(100, Math.round((appState.water.consumedMl / appState.water.goalMl) * 100));
            document.getElementById('water-stat-text').innerText = `${(appState.water.consumedMl/1000).toFixed(1)}L / ${(appState.water.goalMl/1000).toFixed(1)}L`;
            document.getElementById('water-progress-bar').style.width = `${wPercent}%`;
            document.getElementById('water-percent').innerText = `${wPercent}%`;

            // Today meals preview
            const todayMeal = appState.meals['Jueves'];
            const mealsPrevEl = document.getElementById('today-meals-preview');
            mealsPrevEl.innerHTML = `
                <div class="flex justify-between items-center text-xs p-2 rounded-lg bg-slate-50 dark:bg-slate-700/40">
                    <span class="font-medium">☕ Desayuno:</span> <span class="text-slate-600 dark:text-slate-300">${todayMeal.desayuno}</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2 rounded-lg bg-slate-50 dark:bg-slate-700/40">
                    <span class="font-medium">🍲 Almuerzo:</span> <span class="text-slate-600 dark:text-slate-300">${todayMeal.almuerzo}</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2 rounded-lg bg-slate-50 dark:bg-slate-700/40">
                    <span class="font-medium">🍎 Merienda:</span> <span class="text-slate-600 dark:text-slate-300">${todayMeal.merienda}</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2 rounded-lg bg-slate-50 dark:bg-slate-700/40">
                    <span class="font-medium">🌙 Cena:</span> <span class="text-slate-600 dark:text-slate-300">${todayMeal.cena}</span>
                </div>
            `;
        }

        // --- Calendar Rendering ---
        let currentCalendarView = 'semana';
        function setCalendarView(view) {
            currentCalendarView = view;
            if (view === 'semana') {
                document.getElementById('btn-view-semana').className = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-600 shadow-sm transition-all";
                document.getElementById('btn-view-dia').className = "px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 transition-all";
            } else {
                document.getElementById('btn-view-dia').className = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-600 shadow-sm transition-all";
                document.getElementById('btn-view-semana').className = "px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 transition-all";
            }
            renderCalendar();
        }

        function renderCalendar() {
            const gridEl = document.getElementById('calendar-grid');
            const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
            
            const activeDays = currentCalendarView === 'semana' ? days : ['Jueves']; // Default day for 'dia' view

            gridEl.className = currentCalendarView === 'semana' 
                ? "grid grid-cols-1 md:grid-cols-7 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-700"
                : "grid grid-cols-1 divide-y divide-slate-200 dark:divide-slate-700 max-w-2xl mx-auto";

            gridEl.innerHTML = activeDays.map(day => {
                const dayActs = appState.activities.filter(a => a.day === day).sort((a,b) => a.start.localeCompare(b.start));
                return `
                    <div class="p-4 flex flex-col min-h-[300px]">
                        <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100 dark:border-slate-700">
                            <h4 class="font-bold text-sm text-primary-600 dark:text-primary-400">${day}</h4>
                            <span class="text-[10px] bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded-full text-slate-500">${dayActs.length} acts</span>
                        </div>
                        <div class="space-y-2.5 flex-1">
                            ${dayActs.length === 0 ? `<p class="text-xs text-slate-400 italic py-4 text-center">Sin actividades</p>` : ''}
                            ${dayActs.map(act => `
                                <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/40 relative group shadow-sm hover:shadow transition-all">
                                    <div class="flex justify-between items-start">
                                        <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-primary-100 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300">${act.category}</span>
                                        <div class="flex items-center space-x-1">
                                            <button onclick="toggleActivityComplete('${act.id}')" class="text-xs ${act.completed ? 'text-emerald-500' : 'text-slate-300'} hover:text-emerald-600"><i class="fa-solid fa-circle-check"></i></button>
                                            <button onclick="deleteActivity('${act.id}')" class="text-xs text-slate-300 hover:text-red-500"><i class="fa-solid fa-trash"></i></button>
                                        </div>
                                    </div>
                                    <h5 class="text-xs font-bold mt-2 ${act.completed ? 'line-through text-slate-400' : ''}">${act.title}</h5>
                                    <p class="text-[11px] text-slate-500 mt-0.5"><i class="fa-regular fa-clock mr-1"></i>${act.start} - ${act.end}</p>
                                </div>
                            `).join('')}
                        </div>
                        <button onclick="openActivityModalForDay('${day}')" class="mt-3 w-full py-2 border border-dashed border-slate-300 dark:border-slate-600 text-slate-500 hover:text-primary-600 hover:border-primary-500 rounded-xl text-xs font-medium transition-all flex items-center justify-center gap-1">
                            <i class="fa-solid fa-plus text-[10px]"></i> Agregar
                        </button>
                    </div>
                `;
            }).join('');
        }

        // --- Meals Rendering ---
        function renderMeals() {
            const container = document.getElementById('weekly-menu-container');
            const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];

            container.innerHTML = days.map(day => {
                const meal = appState.meals[day];
                return `
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div class="w-full md:w-32">
                            <h4 class="font-bold text-sm text-primary-600 dark:text-primary-400">${day}</h4>
                            <span class="text-[10px] text-slate-400">Menú equilibrado</span>
                        </div>
                        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 w-full text-xs">
                            <div class="bg-slate-50 dark:bg-slate-700/40 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-600/50">
                                <span class="font-semibold text-slate-400 block text-[10px]">DESAYUNO</span>
                                <span class="font-medium mt-0.5 block">${meal.desayuno}</span>
                                ${appState.showCalories ? '<span class="text-[10px] text-amber-500 mt-1 block">~320 kcal (aprox)</span>' : ''}
                            </div>
                            <div class="bg-slate-50 dark:bg-slate-700/40 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-600/50">
                                <span class="font-semibold text-slate-400 block text-[10px]">ALMUERZO</span>
                                <span class="font-medium mt-0.5 block">${meal.almuerzo}</span>
                                ${appState.showCalories ? '<span class="text-[10px] text-amber-500 mt-1 block">~550 kcal (aprox)</span>' : ''}
                            </div>
                            <div class="bg-slate-50 dark:bg-slate-700/40 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-600/50">
                                <span class="font-semibold text-slate-400 block text-[10px]">MERIENDA</span>
                                <span class="font-medium mt-0.5 block">${meal.merienda}</span>
                                ${appState.showCalories ? '<span class="text-[10px] text-amber-500 mt-1 block">~210 kcal (aprox)</span>' : ''}
                            </div>
                            <div class="bg-slate-50 dark:bg-slate-700/40 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-600/50">
                                <span class="font-semibold text-slate-400 block text-[10px]">CENA</span>
                                <span class="font-medium mt-0.5 block">${meal.cena}</span>
                                ${appState.showCalories ? '<span class="text-[10px] text-amber-500 mt-1 block">~480 kcal (aprox)</span>' : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleCaloriesDisplay() {
            appState.showCalories = document.getElementById('toggle-calories-view').checked;
            renderMeals();
        }

        function generateShoppingList() {
            const listEl = document.getElementById('shopping-list-container');
            const sampleIngredients = [
                { category: 'Verduras y Frutas', items: ['Palta (3)', 'Tomates (1kg)', 'Espinaca (2 paquetes)', 'Bananas (6)', 'Limones (4)'] },
                { category: 'Carnes y Pescados', items: ['Pechuga de pollo (1kg)', 'Filet de merluza (500g)', 'Salmón (2 porciones)'] },
                { category: 'Almacén y Granos', items: ['Quinoa (500g)', 'Arroz integral (1kg)', 'Avena tradicional (1 bolsa)', 'Pan integral (2 moldes)'] },
                { category: 'Lácteos y Huevos', items: ['Huevos (docena)', 'Yogurt natural (2)', 'Queso crema descremado'] }
            ];

            listEl.innerHTML = sampleIngredients.map(group => `
                <div class="space-y-1 mb-3">
                    <h5 class="text-xs font-bold text-primary-600 dark:text-primary-400">${group.category}</h5>
                    <ul class="list-disc list-inside text-xs text-slate-600 dark:text-slate-300 space-y-0.5 pl-1">
                        ${group.items.map(item => `<li>${item}</li>`).join('')}
                    </ul>
                </div>
            `).join('');
            showToast('¡Lista de compras generada con éxito!', 'success');
        }

        function clearShoppingList() {
            document.getElementById('shopping-list-container').innerHTML = `<p class="text-xs text-slate-400 italic">Lista vacía.</p>`;
            showToast('Lista limpiada.', 'info');
        }

        // --- Habits & Water ---
        function addWater(amount) {
            appState.water.consumedMl += amount;
            appState.water.history.push(amount);
            saveState();
            renderAll();
            showToast(`+${amount} ml de agua agregados`, 'success');
        }

        function undoWater() {
            if (appState.water.history.length > 0) {
                const last = appState.water.history.pop();
                appState.water.consumedMl = Math.max(0, appState.water.consumedMl - last);
                saveState();
                renderAll();
                showToast(`Se deshicieron ${last} ml`, 'info');
            } else {
                showToast('No hay registros para deshacer hoy', 'info');
            }
        }

        function renderHabits() {
            const listEl = document.getElementById('habits-list-container');
            listEl.innerHTML = appState.habits.map(h => `
                <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/60 dark:border-slate-600/60">
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" ${h.completedToday ? 'checked' : ''} onchange="toggleHabit('${h.id}')" class="w-4 h-4 text-primary-600 rounded border-slate-300">
                        <span class="text-sm font-medium ${h.completedToday ? 'line-through text-slate-400' : ''}">${h.title}</span>
                    </div>
                    <span class="text-[10px] px-2 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 font-semibold">Diario</span>
                </div>
            `).join('');

            // Also update habit water total in the habit tab
            document.getElementById('habit-water-total').innerText = `${appState.water.consumedMl.toLocaleString()} ml`;
            document.getElementById('habit-water-goal').innerText = `${appState.water.goalMl.toLocaleString()} ml`;
        }

        function toggleHabit(id) {
            const h = appState.habits.find(x => x.id === id);
            if (h) {
                h.completedToday = !h.completedToday;
                saveState();
                renderHabits();
            }
        }

        // --- Stats Rendering ---
        function renderStats() {
            const barsEl = document.getElementById('time-stats-bars');
            const categories = [
                { name: 'Trabajo / Estudio', hours: 28, color: 'bg-primary-500' },
                { name: 'Entrenamiento', hours: 5, color: 'bg-emerald-500' },
                { name: 'Descanso / Sueño', hours: 56, color: 'bg-indigo-500' },
                { name: 'Ocio y Tiempo libre', hours: 14, color: 'bg-accent-500' }
            ];

            barsEl.innerHTML = categories.map(cat => `
                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="font-medium">${cat.name}</span>
                        <span class="font-bold">${cat.hours} hrs</span>
                    </div>
                    <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-2.5 overflow-hidden">
                        <div class="${cat.color} h-full rounded-full" style="width: ${(cat.hours / 60) * 100}%"></div>
                    </div>
                </div>
            `).join('');

            const completedCount = appState.activities.filter(a => a.completed).length;
            document.getElementById('stat-completed-count').innerText = completedCount;
        }

        // --- Activity Modal & Overlap Detection ---
        let selectedDayForNew = 'Jueves';
        function openActivityModal() {
            document.getElementById('activity-modal').classList.remove('hidden');
        }
        function openActivityModalForDay(day) {
            selectedDayForNew = day;
            document.getElementById('act-day').value = day;
            openActivityModal();
        }
        function closeActivityModal() {
            document.getElementById('activity-modal').classList.add('hidden');
        }

        function saveActivity() {
            const title = document.getElementById('act-title').value.trim();
            const day = document.getElementById('act-day').value;
            const category = document.getElementById('act-category').value;
            const start = document.getElementById('act-start').value;
            const end = document.getElementById('act-end').value;
            const priority = document.getElementById('act-priority').value;

            if (!title) {
                showToast('Por favor ingresa un título para la actividad', 'error');
                return;
            }

            // Check overlap
            const existing = appState.activities.filter(a => a.day === day);
            let hasOverlap = false;
            for (let act of existing) {
                if (!(end <= act.start || start >= act.end)) {
                    hasOverlap = true;
                    break;
                }
            }

            if (hasOverlap) {
                closeActivityModal();
                showProposalModal({ title, day, category, start, end, priority });
                return;
            }

            const newAct = { id: Date.now().toString(), title, day, category, start, end, priority, completed: false };
            appState.activities.push(newAct);
            saveState();
            renderAll();
            closeActivityModal();
            showToast('Actividad agregada con éxito', 'success');
            document.getElementById('act-title').value = '';
        }

        let pendingProposalActivity = null;
        function showProposalModal(act) {
            pendingProposalActivity = act;
            const modal = document.getElementById('proposal-modal');
            const content = document.getElementById('proposal-content');
            content.innerHTML = `
                <div class="bg-amber-50 dark:bg-amber-950/30 p-3 rounded-xl border border-amber-200 dark:border-amber-800 text-xs text-amber-800 dark:text-amber-300">
                    La actividad <b>"${act.title}"</b> (${act.start} - ${act.end} el ${act.day}) se superpone con otro compromiso.
                </div>
                <div class="space-y-3 pt-2">
                    <p class="text-xs font-semibold">Propuesta automática del asistente:</p>
                    <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-200 dark:border-slate-600 text-xs space-y-1">
                        <p><b>Sugerencia:</b> Mover horario de inicio 30 minutos después.</p>
                        <p><b>Nuevo horario sugerido:</b> <span class="text-primary-600 font-bold">18:30 - 20:00</span></p>
                    </div>
                </div>
            `;
            modal.classList.remove('hidden');
        }

        function closeProposalModal() {
            document.getElementById('proposal-modal').classList.add('hidden');
            pendingProposalActivity = null;
        }

        function applyProposal() {
            if (pendingProposalActivity) {
                pendingProposalActivity.start = '18:30';
                pendingProposalActivity.end = '20:00';
                pendingProposalActivity.id = Date.now().toString();
                pendingProposalActivity.completed = false;
                appState.activities.push(pendingProposalActivity);
                saveState();
                renderAll();
                closeProposalModal();
                showToast('Propuesta aplicada con éxito', 'success');
            }
        }

        function toggleActivityComplete(id) {
            const act = appState.activities.find(x => x.id === id);
            if (act) {
                act.completed = !act.completed;
                saveState();
                renderAll();
            }
        }

        function deleteActivity(id) {
            appState.activities = appState.activities.filter(x => x.id !== id);
            saveState();
            renderAll();
            showToast('Actividad eliminada', 'info');
        }

        // --- Onboarding Logic ---
        let currentOnbStep = 1;
        function nextOnboardingStep() {
            if (currentOnbStep < 3) {
                document.querySelector(`[data-step="${currentOnbStep}"]`).classList.add('hidden');
                currentOnbStep++;
                document.querySelector(`[data-step="${currentOnbStep}"]`).classList.remove('hidden');
                document.getElementById('onb-prev-btn').classList.remove('hidden');
                document.getElementById('onb-step-indicator').innerText = `Paso ${currentOnbStep} de 3`;
                if (currentOnbStep === 3) {
                    document.getElementById('onb-next-btn').innerText = 'Comenzar';
                }
            } else {
                finishOnboarding();
            }
        }

        function prevOnboardingStep() {
            if (currentOnbStep > 1) {
                document.querySelector(`[data-step="${currentOnbStep}"]`).classList.add('hidden');
                currentOnbStep--;
                document.querySelector(`[data-step="${currentOnbStep}"]`).classList.remove('hidden');
                document.getElementById('onb-step-indicator').innerText = `Paso ${currentOnbStep} de 3`;
                if (currentOnbStep === 1) {
                    document.getElementById('onb-prev-btn').classList.add('hidden');
                }
                document.getElementById('onb-next-btn').innerText = 'Siguiente';
            }
        }

        function skipOnboarding() {
            finishOnboarding();
        }

        function finishOnboarding() {
            appState.userProfile.sleepTime = document.getElementById('onb-sleep-time').value;
            appState.userProfile.wakeTime = document.getElementById('onb-wake-time').value;
            appState.userProfile.fixedTitle = document.getElementById('onb-fixed-title').value || 'Trabajo Principal';
            appState.userProfile.fixedCategory = document.getElementById('onb-fixed-category').value;
            appState.userProfile.allergies = document.getElementById('onb-allergies').value || 'Ninguna';
            appState.userProfile.isMinor = document.getElementById('onb-minor').checked;

            appState.onboardingCompleted = true;
            saveState();
            document.getElementById('onboarding-modal').classList.add('hidden');
            showToast('¡Configuración guardada con éxito!', 'success');
        }

        // --- Settings / Toast ---
        function requestNotificationPermission() {
            if ('Notification' in window) {
                Notification.requestPermission().then(permission => {
                    if (permission === 'granted') {
                        showToast('¡Notificaciones activadas correctamente!', 'success');
                    } else {
                        showToast('Permiso de notificaciones denegado o limitado por el navegador.', 'info');
                    }
                });
            } else {
                showToast('Tu navegador no soporta notificaciones nativas.', 'info');
            }
        }

        function exportUserData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const dlAnchorElem = document.createElement('a');
            dlAnchorElem.setAttribute("href", dataStr);
            dlAnchorElem.setAttribute("download", "mi_semana_datos.json");
            dlAnchorElem.click();
            showToast('Datos exportados correctamente', 'success');
        }

        function resetAllData() {
            if (confirm('¿Estás seguro de que deseas eliminar todos tus datos? Esta acción no se puede deshacer.')) {
                localStorage.removeItem('mi_semana_state_v2');
                location.reload();
            }
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgCol = type === 'success' ? 'bg-emerald-600 text-white' : type === 'error' ? 'bg-red-600 text-white' : 'bg-slate-800 text-white';
            toast.className = `${bgCol} px-4 py-3 rounded-xl shadow-lg text-xs font-medium pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300 flex items-center space-x-2`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
